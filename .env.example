# Environment configuration
#
# Generated by `npx tsx scripts/generate-env-docs.ts` from src/lib/env-specs.ts.
# Do not edit by hand: change the specification and regenerate.
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# Only variables marked "browser safe" may ever reach the client. Everything
# else is read on the server and must be treated as a secret if marked required.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Secret used to derive session and cookie signing keys. Must be at least 32 characters. Rotating it invalidates every existing session.
# Source: Operator, generated with `openssl rand -base64 32`  |  Read by: Authentication
SESSION_SECRET=

# Base URL of the Python machine learning service.
# Source: Operator  |  Read by: ML client
# Suggested: http://127.0.0.1:8000
ML_SERVICE_URL=

# ---------------------------------------------------------------------------
# Optional — shown with their default value
# ---------------------------------------------------------------------------

# When 'true', the machine learning service is stood in for by an in-process simulator, so the whole application can be browsed without Python running. Every model metric, probability and explanation is generated rather than learned, and the pages label it as simulated. Nothing else about the application changes: the same pages, data layer, schema, sessions and audit trail are used. Never enable this in production.
# Source: Operator  |  Read by: ML client
SIMULATED_MODE=false

# Runtime mode. Set automatically by the deployment platform.
# Source: Framework  |  Read by: Next.js
NODE_ENV=development

# Public origin of the application, used for links in emails and redirects.
# Source: Deployment platform  |  Read by: Auth, email provider
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string. When unset the application uses an embedded PostgreSQL build (PGlite) under .data/postgres, which is suitable for local work and tests but not for production.
# Source: Managed PostgreSQL provider  |  Read by: Database client
DATABASE_URL=

# Forces a driver. 'pglite' uses the embedded database; 'postgres' uses DATABASE_URL.
# Source: Operator  |  Read by: Database client
DATABASE_DRIVER=auto

# Set to 'true' to require TLS on the PostgreSQL connection.
# Source: Managed PostgreSQL provider  |  Read by: Database client
DATABASE_SSL=false

# Maximum pooled PostgreSQL connections per process.
# Source: Operator  |  Read by: Database client
DATABASE_POOL_MAX=10

# How long a session stays valid before the user must sign in again.
# Source: Operator  |  Read by: Authentication
SESSION_TTL_HOURS=8

# Lifetime of a password reset token.
# Source: Operator  |  Read by: Authentication
PASSWORD_RESET_TTL_MINUTES=30

# Directory for uploaded datasets, generated reports and chart images.
# Source: Operator  |  Read by: File storage
STORAGE_DIR=storage

# Largest accepted dataset upload, in bytes.
# Source: Operator  |  Read by: Dataset upload
MAX_UPLOAD_BYTES=26214400

# Shared secret presented to the ML service. Optional for local development; required whenever ML_REQUIRE_API_KEY is set on the service.
# Source: Operator, must match the ML service  |  Read by: ML client
ML_SERVICE_API_KEY=

# Timeout for a single call to the ML service.
# Source: Operator  |  Read by: ML client
ML_REQUEST_TIMEOUT_MS=600000

# Customers sampled for a global SHAP explanation.
# Source: Operator  |  Read by: ML client
ML_SHAP_SAMPLE_SIZE=1000

# Which transactional email provider to use. 'log' writes messages to the server log.
# Source: Operator  |  Read by: Email provider
EMAIL_PROVIDER=log

# API key for the transactional email provider used to deliver password reset links. Without it, reset links are written to the server log instead of emailed, which is only appropriate for local work.
# Source: Email provider dashboard  |  Read by: Email provider
EMAIL_PROVIDER_API_KEY=

# From address for transactional email.
# Source: Operator  |  Read by: Email provider
EMAIL_FROM=

# Email of the administrator created by the seed script.
# Source: Operator  |  Read by: Seed script
SEED_ADMIN_EMAIL=

# Password for the seeded administrator. Only read by the seed script.
# Source: Operator  |  Read by: Seed script
SEED_ADMIN_PASSWORD=
